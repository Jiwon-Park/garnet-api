[Unit]
Description=Garnet API Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=garnet-api
Group=garnet-api
WorkingDirectory=/opt/garnet-api
EnvironmentFile=-/etc/garnet-api/garnet-api.env
ExecStart=/opt/garnet-api/garnet-api
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/garnet-api
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
